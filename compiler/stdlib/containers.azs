void list_sort_int(List<int> * xs):0025 {
    if (xs == null) { containers__bounds(); }
    Node<int> * i = xs.head;
    if (i == null) { return; }
    i = i.next;
    while (i != null) {
        int saved = i.value;
        Node<int> * j = i;
        while (j.prev != null && j.prev.value > saved) {
            j.value = j.prev.value;
            j = j.prev;
        }
        j.value = saved;
        i = i.next;
    }
}

void list_sort_double(List<double> * xs):0026 {
    if (xs == null) { containers__bounds(); }
    Node<double> * i = xs.head;
    if (i == null) { return; }
    i = i.next;
    while (i != null) {
        double saved = i.value;
        Node<double> * j = i;
        while (j.prev != null && j.prev.value > saved) {
            j.value = j.prev.value;
            j = j.prev;
        }
        j.value = saved;
        i = i.next;
    }
}

void list_sort_address(List<address> * xs):0027 {
    if (xs == null) { containers__bounds(); }
    Node<address> * i = xs.head;
