    while (i != null) {
        address saved = i.value;
        Node<address> * j = i;
        while (j.prev != null && j.prev.value > saved) {
            j.value = j.prev.value;
            j = j.prev;
        }
        j.value = saved;
        i = i.next;
    }
}

int list_find_int(List<int> * xs, int value):0028 {
    if (xs == null) { containers__bounds(); }
    Node<int> * cursor = xs.head;
    int index = 0;
    while (cursor != null) {
        if (cursor.value == value) { return index; }
        cursor = cursor.next;
        index++;
    }
    return -1;
}

