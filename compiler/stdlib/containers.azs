// Empty storage grows to 4, then doubles. A double that would overflow int32 uses the exact size.
int containers__next_capacity(int cap, int needed) {
    if (needed < 0) { containers__bounds(); }
    if (cap >= needed) { return cap; }
    int next = needed;
    if (cap == 0) { next = 4; }
    else if (cap <= 1073741823) { next = cap * 2; }
    if (next < needed) { next = needed; }
    return next;
}

<T> int containers__order(int id, T left, T right) {
    if (id == 0) { return value_compare<T>(left, right); }
    return reflect_invoke_function<int>(id, left, right);
}

<T> int containers__set_lower(Set<T> * xs, T value) {
    int lo = 0;
    int hi = xs.items.length();
    while (lo < hi) {
        int mid = lo + (hi - lo) / 2;
        if (containers__order(xs.order, xs.items.get(mid), value) < 0) { lo = mid + 1; }
        else { hi = mid; }
    }
    return lo;
}

<K, V> int containers__map_lower(Map<K, V> * xs, K key) {
    int lo = 0;
    int hi = xs.items.length();
    while (lo < hi) {
        int mid = lo + (hi - lo) / 2;
        Entry<K, V> found = xs.items.get(mid);
        if (containers__order(xs.order, found.key, key) < 0) { lo = mid + 1; }
        else { hi = mid; }
    }
    return lo;
}

