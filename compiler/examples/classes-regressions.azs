// Success returns 0. Literal objects are values: a copy copies every slot and
// each copy is destroyed. "Point * p(...)" and "new" create pointer objects.
#gvar destroyed

class Point {
    int x;
    Point * next;

    Point(int value) { this.x = value; }
    int get() { return x; }
    Point * self() { return this; }
    ~Point() { destroyed = destroyed + x; }
}

Point create(int value) {
    {
        Point result(value);
        return result;
    }
}

Point * identity(Point * value) { return value; }

int main() {
    destroyed = 0;
    {
        Point first(2);
        Point copy = first;
        copy.x = 7;
        if (first.get() != 2 || copy.get() != 7 || first.next != null) { return 1; }
    }
    if (destroyed != 9) { return 2; }
    {
        Point returned = create(3);
        if (returned.self().get() != 3) { return 3; }
    }
    if (destroyed != 12) { return 4; }
    {
        Point * first(2);
        Point * alias = first;
        alias.x = 7;
        if (first.get() != 7 || identity(first) != alias) { return 5; }
    }
    if (destroyed != 19) { return 6; }
    Point * manual = null;
    { manual = new Point(5); }
    if (manual.get() != 5 || destroyed != 19) { return 7; }
    delete manual;
    if (destroyed != 24) { return 8; }
    return 0;
}
