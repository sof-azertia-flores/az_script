// Run through the source, readable AST and compact exec paths; success returns 0.
int main() {
    int bits = 0;
    bits |= 1;
    bits <<= 4;
    bits ^= 3;
    bits &= 31;
    bits >>= 1;
    bits >>>= 1;
    if (bits != 4 || ~0 != -1 || (-1 >>> 31) != 1) { return 1; }
    if ((7 & 3) != 3 || (4 | 1) != 5 || (7 ^ 3) != 4) { return 2; }

    int parsed = int("+7");
    if (parsed != 7 || string(parsed) != "7") { return 3; }
    if (double("7.5") != 7.5 || float("1.25") != 1.25) { return 4; }
    int selected = parsed == 7 ? 11 : 12;
    switch (selected) {
        case 10:
        case 11: bits += 1; break;
        default: return 5;
        case 12: return 6;
    }
    if (bits != 5) { return 7; }

    string text = "A中😀\0B";
    if (text.length() != 5 || text.byte_length() != 10) { return 8; }
    if (text.substring(1, 3) != "中😀" || text.char_at(2) != "😀") { return 9; }
    if (text.code_at(2) != 128512 || str_from_code(128512) != "😀") { return 10; }
    if (text.index_of("😀") != 2 || text.index_of("A", 1) != -1) { return 11; }
    if (!text.contains("\0") || !text.starts_with("A") || !text.ends_with("B")) { return 12; }
    if (text[2] != "😀" || text[3] != "\0") { return 13; }

    if (str_length(text) != 5 || str_byte_length(text) != 10) { return 14; }
    if (str_substring(text, 4, 5) != "B" || str_char_at(text, 0) != "A") { return 15; }
    if (str_code_at(text, 1) != 20013 || str_from_code(0) != "\0") { return 16; }
    if (str_index_of(text, "\0B", 3) != 3 || str_index_of(text, "", 5) != 5) { return 17; }
    if (!str_starts_with(text, "A中") || !str_ends_with(text, "\0B")) { return 18; }
    switch (text[2]) {
        case "😀": break;
        default: return 19;
    }
    return 0;
}
