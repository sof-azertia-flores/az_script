#include ../stdlib/math.include.azs

int math_test_check(condition) {
    if (condition) { return 0; }
    return 1;
}

int main() {
    var failures = 0;
    failures += math_test_check(math_is_close(math_pi(), 3.141592653589793, 1e-14, 0.0));
    failures += math_test_check(math_is_close(math_tau(), 2.0 * math_pi(), 1e-14, 0.0));
    failures += math_test_check(math_is_close(math_e(), 2.718281828459045, 1e-14, 0.0));
    failures += math_test_check(math_is_close(math_ln2(), 0.6931471805599453, 1e-14, 0.0));
    failures += math_test_check(1.0 + math_epsilon() != 1.0);
    failures += math_test_check(1.0 + math_epsilon() / 2.0 == 1.0);
    failures += math_test_check(math_abs(-2.5) == 2.5);
    failures += math_test_check(math_abs(-2147483648.0) == 2147483648.0);
    failures += math_test_check(math_abs_int(-17) == 17);
    failures += math_test_check(math_sign(-8.0) == -1 && math_sign(0.0) == 0 && math_sign(9.0) == 1);
    failures += math_test_check(math_min(2.5, -1.0) == -1.0);
    failures += math_test_check(math_max(2.5, -1.0) == 2.5);
    failures += math_test_check(math_min_int(3, 8) == 3);
    failures += math_test_check(math_max_int(3, 8) == 8);
    failures += math_test_check(math_clamp(12.0, 1.0, 8.0) == 8.0);
    failures += math_test_check(math_clamp_int(-2, 1, 8) == 1);
    failures += math_test_check(math_square(3.0) == 9.0 && math_cube(2.0) == 8.0);
    failures += math_test_check(math_square(50000.0) == 2500000000.0);
    failures += math_test_check(math_mean(2147483647.0, -2147483648.0) == -0.5);
    failures += math_test_check(math_mean(2147483647.0, 2147483647.0) == 2147483647.0);
    failures += math_test_check(math_mean(-2147483648.0, -2147483648.0) == -2147483648.0);
    failures += math_test_check(math_mean(5e-324, 1e-323) == 1e-323);
    failures += math_test_check(math_mean(1e-323, 5e-324) == 1e-323);
    failures += math_test_check(math_lerp(10.0, 20.0, 0.25) == 12.5);
    failures += math_test_check(math_lerp(-1e308, 1e308, 0.5) == 0.0);
    failures += math_test_check(math_lerp(1e308, 1e-308, 1.0) == 1e-308);
    failures += math_test_check(math_is_close(math_lerp(1e308, 1e-308, 0.9999999999999999), 1.1102230246251566e292, 1e-12, 0.0));
    failures += math_test_check(math_pow(2.0, 10) == 1024.0);
    failures += math_test_check(math_pow(2.0, -3) == 0.125);
    failures += math_test_check(math_pow(-1.0, -2147483648) == 1.0);
    failures += math_test_check(math_int_pow(-2, 5) == -32 && math_int_pow(2, 30) == 1073741824);
    failures += math_test_check(math_int_pow(46341, 1) == 46341);
    failures += math_test_check(math_is_close(math_sqrt(2.0), 1.4142135623730951, 1e-12, 1e-12));
    failures += math_test_check(math_is_close(math_sqrt(2147483647.0), 46340.950001051984, 1e-12, 0.0));
    failures += math_test_check(math_is_close(math_sqrt(1e-300), 1e-150, 1e-12, 0.0));
    failures += math_test_check(math_trunc(-2.9) == -2);
    failures += math_test_check(math_trunc(2147483647.9) == 2147483647);
    failures += math_test_check(math_trunc(-2147483648.9) == -2147483648);
    failures += math_test_check(math_floor(-2.1) == -3 && math_ceil(-2.1) == -2);
    failures += math_test_check(math_floor(2147483647.9) == 2147483647);
    failures += math_test_check(math_ceil(-2147483648.9) == -2147483648);
    failures += math_test_check(math_floor(-2147483648.0) == -2147483648);
    failures += math_test_check(math_ceil(2147483647.0) == 2147483647);
    failures += math_test_check(math_round(2.5) == 3 && math_round(-2.5) == -3);
    failures += math_test_check(math_round(2147483647.4) == 2147483647);
    failures += math_test_check(math_round(-2147483648.4) == -2147483648);
    failures += math_test_check(math_is_close(math_fraction(-2.25), 0.75, 0.0, 1e-12));
    failures += math_test_check(math_gcd(54, 24) == 6 && math_lcm(21, 6) == 42);
    failures += math_test_check(math_gcd(-54, 24) == 6);
    failures += math_test_check(math_gcd(0, 0) == 0 && math_lcm(0, 17) == 0);
    failures += math_test_check(math_lcm(46340, 46341) == 2147441940);
    failures += math_test_check(math_positive_mod(-7, 5) == 3);
    failures += math_test_check(math_floor_div(-7, 3) == -3 && math_floor_div(7, -3) == -3);
    failures += math_test_check(math_ceil_div(-7, 3) == -2 && math_ceil_div(7, -3) == -2);
    failures += math_test_check(math_is_even(-4) && math_is_odd(-3));
    failures += math_test_check(math_factorial(12) == 479001600);
    failures += math_test_check(math_fibonacci(46) == 1836311903);
    failures += math_test_check(math_hypot(3.0, 4.0) == 5.0);
    failures += math_test_check(math_is_close(math_hypot(3e200, 4e200), 5e200, 1e-12, 0.0));
    failures += math_test_check(math_is_close(math_to_degrees(math_pi()), 180.0, 1e-12, 1e-12));
    failures += math_test_check(math_is_close(math_to_radians(180.0), math_pi(), 1e-12, 1e-12));
    failures += math_test_check(math_is_close(math_to_degrees(1e306), 5.729577951308232e307, 1e-12, 0.0));
    failures += math_test_check(math_is_close(math_to_radians(1e308), 1.7453292519943295e306, 1e-12, 0.0));
    failures += math_test_check(math_to_degrees(5e-324) == 2.8e-322);
    failures += math_test_check(math_to_radians(2.47e-322) == 5e-324);
    failures += math_test_check(math_is_close(math_sin(math_pi() / 2.0), 1.0, 1e-11, 1e-11));
    failures += math_test_check(math_is_close(math_cos(math_pi()), -1.0, 1e-11, 1e-11));
    failures += math_test_check(math_is_close(math_sin(-2147483648.0), 0.9713101757929392, 1e-5, 1e-5));
    failures += math_test_check(math_is_close(math_tan(math_pi() / 4.0), 1.0, 1e-10, 1e-10));
    failures += math_test_check(math_is_close(math_exp(1.0), math_e(), 1e-11, 1e-11));
    failures += math_test_check(math_exp(-745.1332191019411) == 5e-324);
    failures += math_test_check(math_is_close(math_exp(709.782712893384), 1.7976931348622732e308, 1e-12, 0.0));
    failures += math_test_check(math_is_close(math_log(math_e()), 1.0, 1e-11, 1e-11));
    failures += math_test_check(math_is_close(math_exp(math_log(123.5)), 123.5, 1e-10, 1e-10));
    failures += math_test_check(math_is_close(math_log2(8.0), 3.0, 1e-11, 1e-11));
    failures += math_test_check(math_is_close(math_log10(1000.0), 3.0, 1e-11, 1e-11));
    failures += math_test_check(math_is_close(math_log_base(81.0, 3.0), 4.0, 1e-11, 1e-11));
    failures += math_test_check(math_is_close(math_exp2(10.0), 1024.0, 1e-11, 1e-11));
    failures += math_test_check(math_exp2(-1074.0) == 5e-324 && math_exp2(-1075.0) == 0.0);
    failures += math_test_check(math_exp(-1000.0) == 0.0);
    failures += math_test_check(math_is_close(math_sinh(0.5), 0.5210953054937474, 1e-10, 1e-10));
    failures += math_test_check(math_is_close(math_sinh(1e-10), 1e-10, 1e-12, 1e-20));
    failures += math_test_check(math_is_close(math_sinh(710.0), 1.1169973830808557e308, 1e-10, 0.0));
    failures += math_test_check(math_is_close(math_cosh(0.5), 1.1276259652063807, 1e-10, 1e-10));
    failures += math_test_check(math_is_close(math_cosh(-710.0), 1.1169973830808557e308, 1e-10, 0.0));
    failures += math_test_check(math_is_close(math_tanh(0.5), 0.4621171572600098, 1e-10, 1e-10));
    failures += math_test_check(math_tanh(25.0) == 1.0 && math_tanh(-25.0) == -1.0);
    failures += math_test_check(math_approximately_equal(0.1 + 0.2, 0.3));
    failures += math_test_check(!math_is_close(2147483647.0, -2147483648.0, 1e-9, 0.0));
    failures += math_test_check(!math_is_close(1e308, -1e308, 1e-9, 0.0));
    failures += math_test_check(math_is_close(1e308, -1e308, 2.0, 0.0));
    failures += math_test_check(math_is_close(1e308, -1e307, 0.0, 1.1e308));
    failures += math_test_check(!math_is_close(1e308, -1e308, 0.0, 1.7976931348623157e308));
    return failures;
}
