#!/usr/bin/env python3
import os
from pathlib import Path
import sys
root=Path(__file__).resolve().parent
classpath=root/'build/java/classpath.txt'
if not classpath.is_file():
    sys.exit('Run python3 tools/build_and_test.py first, from the new directory.')
os.execvp('java',['java','-cp',classpath.read_text(encoding='utf-8'),'azertia.Main',*sys.argv[1:]])
