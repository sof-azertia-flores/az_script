class Point {
    int x;
    Point * next; // Non-owning pointer; defaults to null.

    Point(int value) { this.x = value; }
    int get() { return x; }
    ~Point() { print("destroy Point(" + x + ")"); }
}

Point makePoint(int value) {
    Point point(value);
    return point; // A literal object moves to the caller without a copy.
}

int main() {
    Point literal = makePoint(3);
    Point copy = literal; // Copies every slot; each copy is destroyed.
    copy.x = 7;
    print(literal.get());
    print(copy.get());

    Point * scoped(4); // Pointer object destroyed with this block.
    Point * manual = new Point(5);
    print(manual.get());
    delete manual;
    return 0; // scoped, copy and literal are destroyed in reverse order.
}
